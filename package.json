{
  "name": "dee",
  "version": "6.0.3",
  "type": "module",
  "description": "CSS compiler for the The Dee Sanction system",
  "scripts": {
    "build": "gulp build",
    "build:watch": "gulp watch",
    "link-project": "gulp link",
    "clean": "gulp clean",
    "clean:link": "gulp link --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.js,.cjs .",
    "lint:fix": "eslint --ext .ts,.js,.cjs --fix .",
    "format": "prettier --write \"./**/*.(ts|js|cjs|json|yml|scss)\"",
    "test": "echo \"Error: no tests specified\" && exit 0",
    "test:ci": "echo \"Error: no tests specified\" && exit 0",
    "cypress:open": "cypress open",
    "createSymlinks": "node ./tools/create-symlinks.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Chris Sharp",
  "license": "MIT",
  "private": true,
	"devDependencies": {
		"@foundryvtt/foundryvtt-cli": "^1.0.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/stream": "^3.0.1",
		"fs-extra": "^11.4.1",
		"gulp-autoprefixer": "^10.0.0",
		"gulp-sass": "^6.0.1",
		"gulp-sourcemaps": "^3.0.0",
		"sass": "^1.105.1",
		"vinyl-buffer": "^1.0.1",
		"vinyl-source-stream": "^2.0.0"
	},
	"dependencies": {
		"gulp": "^5.0.1"
	}
}
